@{
    ViewData["Title"] = "viewEmployee";
}

<!-- Page Header (Smaller heading, single Add Employee button) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">Employees</h3>
    <button class="btn btn-primary align-items-center gap-2 px-3 py-2 fw-medium shadow-sm d-none" id="btnAddEmployee" onclick="openAddEmployeeModal()">
        <i class="bi bi-plus-circle"></i>
        <span>Add Employee</span>
    </button>
</div>

<!-- Employees Table Grid -->
<div class="card border-0 shadow-sm rounded-2">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th style="width: 110px;" class="ps-4 fw-bold text-dark">Actions</th>
                        <th style="width: 130px;" class="fw-bold text-dark">Code</th>
                        <th class="fw-bold text-dark">Username / Name</th>
                        <th class="fw-bold text-dark">Email</th>
                        <th class="fw-bold text-dark">Department</th>
                        <th class="fw-bold text-dark">Designation</th>
                        <th style="width: 140px;" class="fw-bold text-dark">Role</th>
                        <th style="width: 100px;" class="fw-bold text-dark">Status</th>
                    </tr>
                </thead>
                <tbody id="employeesTableBody">
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            Loading employees...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add / Edit Employee Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="empModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-3 p-2">
            <div class="modal-header border-0 pb-0 pt-3 px-3">
                <h4 class="modal-title fw-bold text-dark" id="empModalTitle">Add Employee</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 pt-3 pb-2">
                <form id="employeeForm" novalidate onsubmit="return false;">
                    <input type="hidden" id="employeeId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6" id="divEmployeeCode" style="display: none;">
                            <label for="employeeCode" class="form-label fw-semibold text-dark">
                                Employee Code
                            </label>
                            <input type="text" class="form-control custom-input bg-light text-muted" id="employeeCode" placeholder="Employee Code" maxlength="15" disabled readonly />
                            <div class="invalid-feedback" id="codeFeedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="fullName" class="form-label fw-semibold text-dark">
                                Username / Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control custom-input" id="fullName" placeholder="Enter Username / Name" maxlength="50" required />
                            <div class="invalid-feedback" id="nameFeedback">Username / Name is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="email" class="form-label fw-semibold text-dark">
                                Email Address <span class="text-danger">*</span>
                            </label>
                            <input type="email" class="form-control custom-input" id="email" placeholder="Enter Email Address" maxlength="150" required />
                            <div class="invalid-feedback" id="emailFeedback">Valid email address is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="departmentId" class="form-label fw-semibold text-dark">
                                Department <span class="text-danger">*</span>
                            </label>
                            <select class="form-select custom-input" id="departmentId" required>
                                <option value="">(Select Department)</option>
                            </select>
                            <div class="invalid-feedback" id="deptFeedback">Please select a department.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="employeeRole" class="form-label fw-semibold text-dark">
                                Role <span class="text-danger">*</span>
                            </label>
                            <select class="form-select custom-input" id="employeeRole" required>
                                <option value="">(Select Role)</option>
                            </select>
                            <div class="invalid-feedback" id="roleFeedback">Please select a role.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="designation" class="form-label fw-semibold text-dark">
                                Designation
                            </label>
                            <input type="text" class="form-control custom-input" id="designation" placeholder="Enter Designation" maxlength="50" />
                            <div class="invalid-feedback" id="desigFeedback">Designation cannot exceed 50 characters.</div>
                        </div>

                        <div class="col-md-6" id="divEmployeePassword">
                            <label for="employeePassword" class="form-label fw-semibold text-dark">
                                Password <span class="text-danger">*</span>
                            </label>
                            <div class="input-group has-validation">
                                <input type="password" class="form-control custom-input" id="employeePassword" placeholder="Enter Password" maxlength="50" autocomplete="new-password" required />
                                <button class="btn btn-outline-secondary" type="button" id="btnToggleEmpPassword" onclick="toggleEmpPasswordVisibility()" title="Toggle password visibility">
                                    <i class="bi bi-eye" id="iconEmpPassword"></i>
                                </button>
                                <div class="invalid-feedback" id="passwordFeedback">Password is required.</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="isActive" class="form-label fw-semibold text-dark">Status <span class="text-danger">*</span></label>
                            <select class="form-select custom-input" id="isActive" required>
                                <option value="">(Select Status)</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                            <div class="invalid-feedback" id="activeFeedback">Please select a status.</div>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Centered Save and Cancel Buttons -->
            <div class="modal-footer border-top justify-content-center px-3 pt-3 pb-3 gap-3">
                <button type="button" class="btn btn-primary px-4 fw-medium" id="btnSaveEmployee" onclick="saveEmployee()">
                    Save
                </button>
                <button type="button" class="btn btn-secondary px-4 fw-medium" data-bs-dismiss="modal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteEmpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-3 text-center p-3">
            <div class="modal-body py-2">
                <div class="text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                <h5 class="fw-bold mb-2">Delete Employee?</h5>
                <p class="text-muted small mb-0">
                    Are you sure you want to delete <span class="fw-bold text-dark" id="deleteEmpNameText"></span>?
                </p>
            </div>
            <div class="d-flex justify-content-center gap-3 pt-3">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm px-3" id="btnConfirmEmpDelete" onclick="confirmDeleteEmployee()">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/employee.js" asp-append-version="true"></script>
}
