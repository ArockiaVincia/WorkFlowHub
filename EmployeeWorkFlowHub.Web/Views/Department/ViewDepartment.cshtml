@{
    ViewData["Title"] = "viewDepartment";
}

<!-- Page Header (Smaller heading, single Add Department button) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">Departments</h3>
    <button class="btn btn-primary align-items-center gap-2 px-3 py-2 fw-medium shadow-sm d-none" id="btnAddDepartment" onclick="openAddModal()">
        <i class="bi bi-plus-circle"></i>
        <span>Add Department</span>
    </button>
</div>

<!-- Departments Table Grid: Actions | Department Name | Employee Count | Project Count (Normal Left-Aligned Spacing) -->
<div class="card border-0 shadow-sm rounded-2">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th style="width: 120px;" class="ps-4 fw-bold text-dark">Actions</th>
                        <th style="width: 35%;" class="fw-bold text-dark">Department Name</th>
                        <th style="width: 25%;" class="fw-bold text-dark">Employee Count</th>
                        <th style="width: 25%;" class="fw-bold text-dark">Project Count</th>
                    </tr>
                </thead>
                <tbody id="departmentsTableBody">
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            Loading departments...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add / Edit Department Modal (Centered Save / Cancel buttons with validation) -->
<div class="modal fade" id="departmentModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3 p-2">
            <div class="modal-header border-0 pb-0 pt-3 px-3">
                <h4 class="modal-title fw-bold text-dark" id="modalTitle">Add Department</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 pt-3 pb-2">
                <form id="departmentForm" novalidate onsubmit="return false;">
                    <input type="hidden" id="departmentId" value="0" />
                    <div class="mb-3">
                        <label for="departmentName" class="form-label fw-semibold text-dark">
                            Department Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control form-control-lg custom-input" 
                               id="departmentName" 
                               placeholder="Enter Department Name" 
                               maxlength="50" 
                               required />
                        <div class="invalid-feedback" id="nameFeedback">
                            Department Name is required.
                        </div>
                    </div>
                </form>
            </div>
            <!-- Centered Save and Cancel Buttons -->
            <div class="modal-footer border-top justify-content-center px-3 pt-3 pb-3 gap-3">
                <button type="button" class="btn btn-primary px-4 fw-medium" id="btnSaveDepartment" onclick="saveDepartment()">
                    Save
                </button>
                <button type="button" class="btn btn-secondary px-4 fw-medium" data-bs-dismiss="modal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-3 text-center p-3">
            <div class="modal-body py-2">
                <div class="text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                <h5 class="fw-bold mb-2">Delete Department?</h5>
                <p class="text-muted small mb-0">
                    Are you sure you want to delete <span class="fw-bold text-dark" id="deleteDeptNameText"></span>?
                </p>
            </div>
            <div class="d-flex justify-content-center gap-3 pt-3">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm px-3" id="btnConfirmDelete" onclick="confirmDeleteDepartment()">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/department.js" asp-append-version="true"></script>
}
